# ─── Core ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Origin the browser uses. OAuth redirect URIs are built from it:
#   Google : ${APP_URL}/auth/google/callback
#   Slack  : ${APP_URL}/api/integrations/slack/callback
APP_URL=http://localhost:5173
SESSION_SECRET=replace-with-a-long-random-string-32+chars

# ─── Data stores (docker compose up -d) ───────────────────────────────────
DATABASE_URL=postgres://sendline:sendline@localhost:5433/sendline
DATABASE_SSL=false
REDIS_URL=redis://localhost:6380
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX=sendline-emails

# ─── Google OAuth (console.cloud.google.com → Credentials → OAuth client, type "Web") ─
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Slack OAuth (api.slack.com/apps → OAuth & Permissions, scope: incoming-webhook) ─
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ─── Throughput (all configurable, nothing hardcoded) ─────────────────────
WORKER_CONCURRENCY=5
# Minimum gap between two sends from the same sender (provider throttling)
MIN_SEND_GAP_MS=2000
# Server-side ceiling per sender per window; the compose form can only go lower
MAX_EMAILS_PER_HOUR_PER_SENDER=50
SEND_MAX_ATTEMPTS=3
# Length of a rate window. Keep 3600000 (1h) in production; e.g. 120000 shrinks it for a demo
RATE_WINDOW_MS=3600000
RECONCILE_ON_BOOT=true

# ─── Ethereal senders ─────────────────────────────────────────────────────
# Existing accounts from https://ethereal.email/create  →  user:pass,user:pass
ETHEREAL_ACCOUNTS=
# …or let Sendline create this many inboxes on first boot (stored encrypted in Postgres)
ETHEREAL_AUTO_PROVISION=3

LOG_LEVEL=info
