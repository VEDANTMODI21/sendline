{
  "name": "sendline-api",
  "version": "1.0.0",
  "description": "Sendline — email scheduling service (Express + BullMQ + Postgres)",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:api": "tsx watch src/main.ts --role=api",
    "dev:worker": "tsx watch src/main.ts --role=worker",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.cjs",
    "start": "node dist/main.js",
    "start:api": "node dist/main.js --role=api",
    "start:worker": "node dist/main.js --role=worker",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "load-test": "tsx scripts/load-test.ts"
  },
  "dependencies": {
    "@bull-board/api": "^6.21.3",
    "@bull-board/express": "^6.21.3",
    "@elastic/elasticsearch": "^8.19.2",
    "bullmq": "^5.81.5",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jose": "^5.10.0",
    "nodemailer": "^10.0.12",
    "pg": "^8.23.0",
    "sanitize-html": "^2.17.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
